{
  "field_id": "quality",
  "rules": [
    {
      "when": "@quality == 'smooth'",
      "ops": [
        {
          "target_id": "user_ini",
          "action": "set",
          "key": "r.UserQualitySetting",
          "value": "0"
        },
        {
          "target_id": "user_ini",
          "action": "set",
          "key": "r.UserQualitySettingTA",
          "value": "0"
        }
      ]
    },
    {
      "when": "@quality == 'balanced'",
      "ops": [
        {
          "target_id": "user_ini",
          "action": "set",
          "key": "r.UserQualitySetting",
          "value": "1"
        },
        {
          "target_id": "user_ini",
          "action": "set",
          "key": "r.UserQualitySettingTA",
          "value": "1"
        }
      ]
    },
    {
      "when": "@quality == 'hd'",
      "ops": [
        {
          "target_id": "user_ini",
          "action": "set",
          "key": "r.UserQualitySetting",
          "value": "2"
        },
        {
          "target_id": "user_ini",
          "action": "set",
          "key": "r.UserQualitySettingTA",
          "value": "2"
        }
      ]
    }
  ]
}
