/* app.wxss - 全局样式 */

page {
  background: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}

/* 重置按钮样式 */
button::after {
  border: none;
}

/* 通用工具类 */
.text-center {
  text-align: center;
}

.text-primary {
  color: #1890ff;
}

.text-success {
  color: #52c41a;
}

.text-error {
  color: #ff4d4f;
}

.text-gray {
  color: #666;
}
