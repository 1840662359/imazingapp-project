<!-- pages/index/index.wxml -->
<view class="container">
  <!-- 原生模板广告置于普通文档流顶部，避免与固定底部操作栏发生层叠。 -->
  <view class="native-ad-section">
    <ad-custom
      class="native-template-ad"
      unit-id="adunit-79a5e9ab4bf8af52"
      bindload="adLoad"
      binderror="adError"
      bindclose="adClose"
    ></ad-custom>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading">
    <view class="loading-text">加载配置中...</view>
  </view>

  <!-- 加载失败 -->
  <view wx:elif="{{error}}" class="error">
    <view class="error-icon">⚠️</view>
    <view class="error-text">{{error}}</view>
    <button class="retry-btn" bindtap="loadSchema">重试</button>
  </view>

  <!-- 配置表单 -->
  <view wx:else class="form-container">
    <!-- 动态字段 -->
    <view class="fields-section">
      <view class="section-title">自定义配置</view>
      <view class="fields-list">
        <dynamic-field
          wx:for="{{fields}}"
          wx:key="id"
          field="{{item}}"
          value="{{selections[item.id]}}"
          bindchange="onFieldChange"
        />
      </view>
    </view>

    <!-- 生成按钮 -->
    <!-- 固定底栏是独立的实心交互层：拦截栏内空白区域触摸，防止手势落到底层列表。 -->
    <view class="actions" catchtap="onBottomBarTap" catchtouchmove="onBottomBarTouchMove">
      <button
        class="generate-btn"
        type="primary"
        bindtap="onGenerate"
        loading="{{generating}}"
        disabled="{{generating}}"
      >
        {{generating ? '生成中...' : '生成配置文件'}}
      </button>
    </view>
  </view>
</view>
