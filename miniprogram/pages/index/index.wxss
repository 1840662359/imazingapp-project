/* pages/index/index.wxss */

.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* 原生模板广告保持在页面顶部的正常文档流中，绝不固定到操作栏区域。 */
.native-ad-section {
  width: 100%;
  box-sizing: border-box;
  background-color: #fff;
  overflow: hidden;
}

.native-template-ad {
  display: block;
  width: 100%;
}

/* 加载中 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
}

.loading-text {
  font-size: 32rpx;
  color: #666;
}

/* 错误状态 */
.error {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  height: 100vh;
  padding: 40rpx;
}

.error-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.error-text {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  margin-bottom: 40rpx;
}

.retry-btn {
  width: 200rpx;
  background: #1890ff;
  color: #fff;
  border: none;
}

/* 表单容器 */
.form-container {
  padding: 30rpx;
}

/* 区块标题 */
.section-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

/* 字段区域 */
.fields-section {
  margin-bottom: 40rpx;
}

.fields-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 操作按钮 */
.actions {
  position: fixed;
  z-index: 1000;
  bottom: 0;
  left: 0;
  right: 0;
  box-sizing: border-box;
  min-height: 130rpx;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  opacity: 1;
  background-color: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.generate-btn {
  width: 100%;
  height: 90rpx;
  background: #1890ff;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.generate-btn::after {
  border: none;
}

.generate-btn[disabled] {
  background: #ccc;
}
