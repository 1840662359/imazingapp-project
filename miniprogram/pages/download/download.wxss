/* pages/download/download.wxss */

.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 40rpx;
}

/* 成功状态 */
.success-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}

.success-icon {
  width: 160rpx;
  height: 160rpx;
  line-height: 160rpx;
  text-align: center;
  background: #52c41a;
  color: #fff;
  border-radius: 50%;
  font-size: 100rpx;
  margin-bottom: 40rpx;
}

.success-title {
  font-size: 48rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.success-desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 60rpx;
}

/* 信息卡片 */
.tip-card {
  width: 100%;
  background: #fff3cd;
  border: 2rpx solid #ffc107;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.tip-icon {
  font-size: 48rpx;
  flex-shrink: 0;
}

.tip-text {
  font-size: 28rpx;
  color: #856404;
  line-height: 1.5;
  flex: 1;
}

/* 按钮 */
.share-btn {
  width: 100%;
  height: 90rpx;
  background: #07c160;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.share-btn::after {
  border: none;
}

.back-btn {
  width: 100%;
  height: 90rpx;
  background: #fff;
  color: #666;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.back-btn::after {
  border: none;
}

/* 原生模板广告置于返回按钮下方的正常文档流中，不参与固定层叠。 */
.native-ad-section {
  width: 100%;
  box-sizing: border-box;
  margin-top: 24rpx;
  background-color: #fff;
  overflow: hidden;
}

.native-template-ad {
  display: block;
  width: 100%;
}

/* 下载中状态 */
.downloading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
}

.downloading-icon {
  font-size: 120rpx;
  margin-bottom: 40rpx;
}

.downloading-text {
  font-size: 36rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
}

.downloading-desc {
  font-size: 28rpx;
  color: #666;
}

/* 错误状态 */
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}

.error-icon {
  width: 160rpx;
  height: 160rpx;
  line-height: 160rpx;
  text-align: center;
  background: #ff4d4f;
  color: #fff;
  border-radius: 50%;
  font-size: 100rpx;
  margin-bottom: 40rpx;
}

.error-title {
  font-size: 48rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.error-desc {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  margin-bottom: 60rpx;
  padding: 0 40rpx;
}

.retry-btn {
  width: 100%;
  height: 90rpx;
  background: #1890ff;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.retry-btn::after {
  border: none;
}
