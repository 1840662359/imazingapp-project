/* components/dynamic-field/dynamic-field.wxss */

.field-container {
  margin: 20rpx 0;
  padding: 20rpx 30rpx;
  background: #fff;
  border-radius: 12rpx;
}

.field-label {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
}

/* Picker (Select) */
.picker-container {
  display: block;
}

.picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
}

.picker-text {
  flex: 1;
  color: #333;
}

.picker-arrow {
  font-size: 36rpx;
  color: #999;
  font-weight: 300;
  transform: rotate(90deg);
}

/* Slider */
.slider-container {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.slider-container slider {
  flex: 1;
}

.slider-value {
  width: 100rpx;
  text-align: right;
  font-size: 28rpx;
  color: #1890ff;
  font-weight: 500;
}

/* Input */
.field-input {
  padding: 20rpx 30rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
}

/* 不支持的类型 */
.unsupported {
  color: #999;
  font-size: 24rpx;
}
